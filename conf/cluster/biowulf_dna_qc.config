/*
 * Biowulf HPC config for BioSkryb bj-dna-qc.
 *
 * Assumptions:
 *   - Run with: -profile singularity,[biowulflocal for local executor, biowulf for slurm executor]
 *   - Wasabi credentials are exported in the job environment.
 *   - Sentieon license server is started before nextflow run at 127.0.0.1:8990.
 */

params {
    config_profile_description = 'Biowulf HPC config for BioSkryb bj-dna-qc'
    clusterOptions = null
    architecture = 'x86'
    
    // Optional: use local scratch for pipeline temp files
    tmp_dir = System.getenv('TMPDIR') ?: "/tmp/${params.timestamp}"
}

docker {
    enabled = false
}

// Singularity settings
singularity {
    enabled = true
    autoPullMode = true
    autoMounts = true
    cacheDir = "/data/${System.getenv('USER')}/nxf_singularity_cache"
    libraryDir = "/data/OpenOmics/SIFs"
    pullTimeout = '90 min'
    envWhitelist = 'https_proxy,http_proxy,ftp_proxy,HTTPS_PROXY,HTTP_PROXY,FTP_PROXY,NO_PROXY,no_proxy,DISPLAY,SLURM_JOB_ID,SLURM_JOBID,SINGULARITY_BINDPATH,TMPDIR,AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,AWS_DEFAULT_REGION,AWS_REGION'
}

// Environment visible to Nextflow tasks
env {
    SINGULARITY_CACHEDIR="/data/${System.getenv('USER')}/.singularity"
    OMP_NUM_THREADS = 1
    OPENBLAS_NUM_THREADS = 1
    PYTHONNOUSERSITE = 1
}

// Wasabi S3-compatible endpoint. Credentials should come from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in the shell or sbatch job
aws {
    region = 'us-east-1'
    
    client {
        endpoint = 'https://s3.us-east-1.wasabisys.com'
        s3PathStyleAccess = true
    }
}

// Perform work directory cleanup after a successful run,
// our publish dir copy strategy is symlink-ing, cleaning up the work dir afterwards would delete the results
cleanup = false
timeline.enabled = true
report.enabled = true
timeline.overwrite = true
report.overwrite = true

process.containerOptions = ""

/*
 * Please use local executor (-profile biowulflocal) for short jobs. And it has
 * to define -c , --mem and lscratch to make nextflow allocate the resource
 * automatically. The settings below may have to be adapted to the allocation
 * for the main nextflow job.
 */

profiles {
    biowulflocal {
        executor {
            name = 'local'
            memory = "${System.getenv('SLURM_MEM_PER_NODE') ?: '4000'} MB"
            cpus = "${System.getenv('SLURM_CPUS_PER_TASK') ?: '2'}"
        }
        process {
            cache = 'lenient'
            memory = "${System.getenv('SLURM_MEM_PER_NODE') ?: '4000'} MB"
            cpus = "${System.getenv('SLURM_CPUS_PER_TASK') ?: '2'}"
            process."withLabel:gpu".containerOptions = "--nv"
            _JAVA_OPTIONS="-Djava.io.tmpdir=${System.getenv('TMPDIR')}"
        }
    }

    biowulf {
        executor {
            name = 'slurm'
            queue = 'norm'
            queueSize = 200
            pollInterval = '2 min'
            queueStatInterval = '5 min'
            submitRateLimit = '6/1min'
        }

        process {
            errorStrategy = { task.exitStatus in [143,137,104,134,139,151,140,247,12,1,250] ? 'retry' : 'finish' }
            maxRetries     = 2
            resourceLimits = [ cpus: 192, memory: 751.GB, time: 240.h ]
            clusterOptions = { "--gres=lscratch:${50 * task.attempt}" }
            scratch = '/lscratch/$SLURM_JOB_ID'
            stageInMode = 'symlink'
            stageOutMode = 'rsync' 
            _JAVA_OPTIONS="-Djava.io.tmpdir=/data/${System.getenv('USER')}/.cache"

            // for running pipeline on group sharing data directory, this can avoid inconsistent files timestamps
            cache = 'lenient'
        }
    }
    
    gpu {
        process {
            withLabel: 'gpu' {
                queue = 'gpu'
                time = { 4.h * task.attempt }
                clusterOptions = '--gres=lscratch:50,gpu:1 --constraint="gpua100|gpuv100|gpuv100x"'
                containerOptions = "--nv"
            }
        }
    }

    /*
     * Important:
     * Upstream bj-dna-qc sets Docker-style containerOptions that mount sentieon_eval.lic. That does not match your working Biowulf Sentieon 
     * setup. This replaces it with local license-server env vars.
     */
    sentieon {
        singularity.envWhitelist = 'https_proxy,http_proxy,ftp_proxy,HTTPS_PROXY,HTTP_PROXY,FTP_PROXY,NO_PROXY,no_proxy,DISPLAY,SLURM_JOB_ID,SLURM_JOBID,SINGULARITY_BINDPATH,TMPDIR,AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,AWS_DEFAULT_REGION,AWS_REGION,SENTIEON_LICENSE,SENTIEON_LICENSE_SERVER,SENTIEON_TMPDIR'
        env {
            
            // Sentieon containers should talk to the local license server started by the sbatch script.
            SENTIEON_LICENSE = '127.0.0.1:8990'
            SENTIEON_LICENSE_SERVER = '127.0.0.1:8990'
            
            // Do not route localhost Sentieon licensing through the Biowulf proxy.
            NO_PROXY = "localhost,127.0.0.1,::1,${System.getenv('NO_PROXY') ?: ''}"
            no_proxy = "localhost,127.0.0.1,::1,${System.getenv('no_proxy') ?: ''}"
        }
        process.containerOptions = "-B /data/OpenOmics/dev/sentieon -B /data/OpenOmics/dev/sentieon/bin/sentieon:/opt/sentieon/sentieon-genomics-202308.03/bin/sentieon --env LOCAL=true --env SENTIEON_LICENSE=127.0.0.1:8990 --env SENTIEON_LICENSE_SERVER=127.0.0.1:8990 --env NO_PROXY=localhost,127.0.0.1,::1 --env no_proxy=localhost,127.0.0.1,::1"
    }

}
