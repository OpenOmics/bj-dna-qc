/*
========================================================================================
 Google DeepVariant — shareable subworkflow config
========================================================================================
 Self-contained defaults. Intended for external users: no references to internal
 container registries, private S3 buckets, or BioSkryb-specific shared configs.
----------------------------------------------------------------------------------------
*/

/*
manifest {
    name            = 'google_deepvariant_wf'
    description     = 'Call small variants from aligned BAMs using Google DeepVariant (make_examples -> call_variants -> postprocess_variants).'
    author          = 'BioSkryb Genomics'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '>=23.10.0'
}
*/

// ------------------------------------------------------------------
// Default parameters — override on the command line or in a params file
// ------------------------------------------------------------------
params {

    // Inputs
    input_csv               = null          // CSV with columns: sample_name,bam[,bai]
    //reference               = null          // Directory containing <reference_fasta_name> + .fai
    reference_fasta_name    = 'genome.fa'   // Filename of the reference fasta within --reference
    regions                 = null          // Optional BED of regions to restrict calling

    // Custom BioSkryb model + population VCFs.
    // Download locally from the BioSkryb public Wasabi bucket — see README for details.
    // Leave null to use the model baked into the DeepVariant container image.
    deepvariant_model       = null                 // Directory containing <checkpoint_filename>
    checkpoint_filename     = 'sc_af.model.ckpt'   // Name of the checkpoint within --deepvariant_model
    population_vcfs         = null                 // Directory of per-chromosome *.vcf.gz files

    // DeepVariant options
    deepvariant_version     = '1.8.0'       // Image tag for google/deepvariant on Docker Hub
    call_variants_batch_size = 1024

    // Output
    outdir                  = './results'

    // Resource ceilings (also used as defaults, see process block below)
    max_cpus                = 32
    max_memory              = 120.GB
    max_time                = 24.h
}


// ------------------------------------------------------------------
// Process defaults
// ------------------------------------------------------------------
process {

    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    // CPU-heavy sharded example generation
    withName: 'DEEPVARIANT_MAKE_EXAMPLES_ONLY' {
        container = "google/deepvariant:${params.deepvariant_version}"
        cpus      = { params.max_cpus   }
        memory    = { params.max_memory }
        time      = { params.max_time   }
    }

    // Model inference — switch to the *-gpu image + containerOptions via the `gpu` profile
    withName: 'DEEPVARIANT_CALL_VARIANTS' {
        container = "google/deepvariant:${params.deepvariant_version}"
        cpus      = 8
        memory    = 30.GB
        time      = { params.max_time }
    }

    // VCF assembly / post-processing
    withName: 'DEEPVARIANT_POSTPROCESS' {
        container = "google/deepvariant:${params.deepvariant_version}"
        cpus      = { params.max_cpus   }
        memory    = { params.max_memory }
        time      = { params.max_time   }
    }
}


// ------------------------------------------------------------------
// Execution profiles
// ------------------------------------------------------------------
profiles {

    // Local Docker execution
    docker {
        docker.enabled      = true
        singularity.enabled = false
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }

    // Local Singularity / Apptainer execution (HPC-friendly)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // GPU acceleration for call_variants (recommended for WGS)
    gpu {
        process {
            withName: 'DEEPVARIANT_CALL_VARIANTS' {
                container        = "google/deepvariant:${params.deepvariant_version}-gpu"
                containerOptions = '--gpus all'
                accelerator      = 1
            }
        }
    }

    // Minimal smoke-test profile
    test {
        params {
            max_cpus   = 4
            max_memory = 15.GB
            max_time   = 2.h
        }
    }
}


// ------------------------------------------------------------------
// Reporting
// ------------------------------------------------------------------
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.svg";       overwrite = true }
